{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public and verified profile for citizen, representative, or department officer.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "username": { "type": "string" },
        "bio": { "type": "string" },
        "location": { "type": "string" },
        "websiteUrl": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "category": { "type": "string", "enum": ["citizen", "representative", "department"] },
        "systemScore": { "type": "number" },
        "publicRating": { "type": "number" },
        "postsCount": { "type": "number" },
        "followersCount": { "type": "number" },
        "followingCount": { "type": "number" },
        "verified": { "type": "boolean" },
        "savedReports": { "type": "array" }
      },
      "required": ["id", "fullName", "username", "category"]
    },
    "ReportIssue": {
      "title": "ReportIssue",
      "description": "Civic grievance or infrastructure report logged by citizens.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorUsername": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "authorCategory": { "type": "string" },
        "authorBadge": { "type": "string" },
        "category": { "type": "string" },
        "text": { "type": "string" },
        "imageUrl": { "type": "string" },
        "images": { "type": "array" },
        "taggedOfficers": { "type": "array" },
        "taggedLeaders": { "type": "array" },
        "urgencyLevel": { "type": "string" },
        "location": { "type": "object" },
        "timestamp": { "type": "string" },
        "status": { "type": "string" },
        "departmentStatusLevel": { "type": "number" },
        "likesCount": { "type": "number" },
        "likedBy": { "type": "array" },
        "reReportsCount": { "type": "number" },
        "reReportedBy": { "type": "array" },
        "repliesCount": { "type": "number" }
      },
      "required": ["id", "authorId", "text", "category", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "UserProfile" },
      "description": "Collection of citizen and official representative accounts."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "ReportIssue" },
      "description": "Public civic complaints and grievance reports."
    }
  }
}
