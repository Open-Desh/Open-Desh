rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Public Users collection
    match /users/{userId} {
      allow read: if isValidId(userId);
      allow create, update: if isValidId(userId);
      allow delete: if false;
    }

    // Reports & Grievance collection
    match /reports/{reportId} {
      allow read: if isValidId(reportId);
      allow create: if isValidId(reportId) && request.resource.data.text is string && request.resource.data.text.size() <= 5000;
      allow update: if isValidId(reportId);
      allow delete: if false;
    }

    // Leaders performance database
    match /leaders/{leaderId} {
      allow read: if isValidId(leaderId);
      allow create, update: if isValidId(leaderId);
      allow delete: if false;
    }

    // Infrastructure projects database
    match /infrastructure/{projectId} {
      allow read: if isValidId(projectId);
      allow create, update: if isValidId(projectId);
      allow delete: if false;
    }

    // Public Budget Ledger database (National, State, District, Village)
    match /budgets/{budgetId} {
      allow read: if isValidId(budgetId);
      allow create, update: if isValidId(budgetId);
      allow delete: if false;
    }

    // Help Center Knowledge Base & Articles
    match /help_articles/{articleId} {
      allow read: if isValidId(articleId);
      allow create, update: if isValidId(articleId);
      allow delete: if false;
    }

    // Aggregated Engagement & Analytics Overview
    match /analytics/{docId} {
      allow read: if isValidId(docId);
      allow create, update: if isValidId(docId);
      allow delete: if false;
    }

    // Official Government & Civic Circulars
    match /circulars/{circularId} {
      allow read: if isValidId(circularId);
      allow create, update: if isValidId(circularId);
      allow delete: if false;
    }

    // Admin Moderation & Audit Logs
    match /moderation_logs/{logId} {
      allow read: if isValidId(logId);
      allow create, update: if isValidId(logId);
      allow delete: if false;
    }

    // System Status & Statistics (Admin summary counts)
    match /system_stats/{docId} {
      allow read: if isValidId(docId);
      allow create, update: if isValidId(docId);
      allow delete: if false;
    }
  }
}
